    "@connectrpc/validate": "^0.2.0",
    "@grpc/grpc-js": "^1.14.4",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "@protobuf-ts/plugin": "^2.11.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "arctic": "^3.7.0",
    "formsnap": "^2.0.1",
    "google-protobuf": "^4.0.2",
