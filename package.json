{
	"name": "fbt-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@bufbuild/buf": "^1.74.0",
		"@bufbuild/protoc-gen-es": "^2.16.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.28.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.57.0",
		"@playwright/test": "^1.64.1",
		"@svelte-put/qr": "^2.1.3",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@vitest/browser-playwright": "^4.1.11",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.12.1",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.16.0",
		"@connectrpc/connect": "^2.2.0",
		"@connectrpc/connect-node": "^2.2.0",
		"@connectrpc/validate": "^0.2.0",
		"@grpc/grpc-js": "^1.14.6",
		"@oslojs/encoding": "^1.1.0",
		"@oslojs/otp": "^1.1.0",
		"@protobuf-ts/grpc-transport": "^2.11.1",
		"@protobuf-ts/plugin": "^2.11.1",
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.3",
		"arctic": "^3.7.0",
		"formsnap": "^2.0.1",
		"google-protobuf": "^4.0.3",
		"ioredis": "^6.0.0",
		"mode-watcher": "^1.1.0",
		"zod": "^4.6.7"
	},
	"allowScripts": {
		"@bufbuild/buf@1.72.0": true,
		"protobufjs@7.6.5": true
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
